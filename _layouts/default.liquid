<!doctype html>
{% assign current_lang = page.lang | default: site.active_lang | default: site.lang %}
<html lang="{{ current_lang }}" dir="{% if current_lang == 'fa' or current_lang == 'ar' %}rtl{% else %}ltr{% endif %}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign is_asset = page.redirect | startswith: '/assets/' %}
        {% if is_asset %}
          {% assign redirect = page.redirect | prepend: site.baseurl_root %}
        {% else %}
          {% assign redirect = page.redirect | prepend: site.baseurl %}
        {% endif %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}

    {% include head.liquid %}

    {% if current_lang == 'fa' or current_lang == 'ar' %}
      <!-- Inline RTL adjustments for Farsi support -->
      <style>
        html[dir="rtl"] {
          text-align: right;
        }
        html[dir="rtl"] .dropdown-menu {
          text-align: right;
        }
        html[dir="rtl"] .ml-auto, html[dir="rtl"] .ms-auto {
          margin-right: auto !important;
          margin-left: 0 !important;
        }
        html[dir="rtl"] .mr-auto, html[dir="rtl"] .me-auto {
          margin-left: auto !important;
          margin-right: 0 !important;
        }
      </style>
    {% endif %}
  </head>

  <!-- Body -->
  <body class="{% if site.navbar_fixed %}fixed-top-nav{% endif %} {% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Header -->
    {% include header.liquid %}

    <!-- Content -->
    <div class="container mt-5" role="main">
      {% if page.toc and page.toc.sidebar %}
        {% if page.toc.sidebar == 'right' %}
          <div class="row">
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
          </div>
        {% else %}
          <div class="row">
            <!-- sidebar, which will move to the top on a small screen -->
            <div class="col-sm-3">
              <nav id="toc-sidebar" class="sticky-top"></nav>
            </div>
            <!-- main content area -->
            <div class="col-sm-9">{{ content }}</div>
          </div>
        {% endif %}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- Footer -->
    {% include footer.liquid %}

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>